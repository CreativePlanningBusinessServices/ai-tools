    {
      "name": "EmployeeRecord",
      "container": false,
      "repetition": {
        "property": "members",
        "filter": "1"
      },
      "elements": [
        {
          "name": "Account Number",
          "value": "[TODO-ACCOUNT-NUMBER]"
        },
        {
          "name": "Social Security Number",
          "value": "{{[SSN of Individual]}}"
        },
        {
          "name": "Employee Number",
          "value": "{{[Employee ID]}}"
        },
        {
          "name": "Employee Division/Location Code",
          "value": ""
        },
        {
          "name": "Class Code",
          "value": "ALL"
        },
        {
          "name": "Employee Last Name",
          "value": "{{[Last Name of Member]}}"
        },
        {
          "name": "Employee Last Name Suffix",
          "value": "{{[Suffix of Member]}}"
        },
        {
          "name": "Employee First Name",
          "value": "{{[First Name of Member]}}"
        },
        {
          "name": "Employee Middle Initial",
          "value": "{{[Middle Initial of Member]}}"
        },
        {
          "name": "Birth Date",
          "value": "{{dateFormat 'yyyyMMdd' [Members Date of Birth]}}"
        },
        {
          "name": "Hire Date",
          "value": "{{dateFormat 'yyyyMMdd' [Member Hire Date]}}"
        },
        {
          "name": "Adjusted Service Date",
          "value": ""
        },
        {
          "name": "Termination Date",
          "value": "{{dateFormat 'yyyyMMdd' [Member Termination Date]}}"
        },
        {
          "name": "Rehire Date",
          "value": "{{dateFormat 'yyyyMMdd' [Member Rehire Date]}}"
        },
        {
          "name": "Street Address Line 1",
          "value": "{{#replaceAll ',' '' [Subscribers Address Line 1]}}{{/replaceAll}}"
        },
        {
          "name": "Street Address Line 2",
          "value": "{{#replaceAll ',' '' [Subscribers Address Line 2]}}{{/replaceAll}}"
        },
        {
          "name": "City Name",
          "value": "{{#replaceAll ',' '' [Subscribers City]}}{{/replaceAll}}"
        },
        {
          "name": "State Code",
          "value": "{{#replaceAll ',' '' [Subscribers State]}}{{/replaceAll}}"
        },
        {
          "name": "Zip Code",
          "value": "{{#replaceAll ',' '' [Subscribers Zip Code]}}{{/replaceAll}}"
        },
        {
          "name": "E-mail address",
          "value": "{{[Member Email Address]}}"
        },
        {
          "name": "Daytime/Work Phone Number",
          "value": "{{[Member Phone Work]}}"
        },
        {
          "name": "Evening/Home Phone Number",
          "value": "{{[Member Phone Home]}}"
        },
        {
          "name": "Mobile Phone Number",
          "value": "{{[Member Phone Cell]}}"
        },
        {
          "name": "Single Sign On Eligibility Code",
          "value": ""
        },
        {
          "name": "Single Sign On Id",
          "value": ""
        },
        {
          "name": "Marital Status Code",
          "value": "{{[Members Marital Status]}}",
          "attributes": {
            "length": {
              "min": 0,
              "max": 1
            }
          }
        },
        {
          "name": "Employee Payroll Frequency",
          "value": "{{#compare [Member Pay Frequency] '==' 'Bi-Weekly'}}26{{else compare [Member Pay Frequency] '==' 'Monthly'}}12{{else compare [Member Pay Frequency] '==' 'Semi-Monthly'}}24{{else compare [Member Pay Frequency] '==' 'Weekly'}}52{{/compare}}"
        },
        {
          "name": "Gender",
          "value": "{{#compare [Members Gender] '==' 'M'}}M{{else compare [Members Gender] '==' 'F'}}F{{else compare [Members Gender] '==' 'U'}}N{{/compare}}"
        },
        {
          "name": "Employee Highly Comp Code",
          "value": ""
        },
        {
          "name": "Insider Investor Code",
          "value": ""
        },
        {
          "name": "Language Code",
          "value": ""
        },
        {
          "name": "Termination Reason Code",
          "value": ""
        },
        {
          "name": "Current Hours Paid",
          "value": "{{[Member Hours Worked]}}"
        },
        {
          "name": "Employer Non-elective Contribution amount",
          "value": ""
        },
        {
          "name": "Employee After-tax Contribution amount",
          "value": ""
        },
        {
          "name": "Employee Pre Tax contribution amount",
          "value": "{{[Deductions].[401k].[Employee Amount]}}"
        },
        {
          "name": "Employee Roth contribution amount",
          "value": "{{[Deductions].[401k Roth].[Employee Amount]}}"
        },
        {
          "name": "Employer Match contribution amount",
          "value": ""
        },
        {
          "name": "Employer Safe Harbor Match Contribution amount",
          "value": ""
        },
        {
          "name": "Employee Loan Repayment",
          "value": "{{add [Deductions].[401k Loan].[Employee Amount] [Deductions].[401k Loan 2].[Employee Amount]}}"
        },
        {
          "name": "Additional Source 1 Contribution Amount",
          "value": ""
        },
        {
          "name": "Additional Source 2 Contribution Amount",
          "value": ""
        },
        {
          "name": "Current Gross Compensation",
          "value": "{{[Member Total Compensation]}}"
        },
        {
          "name": "Current Plan Compensation",
          "value": "{{[Member Total Compensation]}}"
        },
        {
          "name": "Additional Compensation_1",
          "value": ""
        },
        {
          "name": "Additional Compensation_2",
          "value": ""
        },
        {
          "name": "Payroll Period Start Date",
          "value": "{{dateFormat 'yyyyMMdd' [Payroll Start Date]}}"
        },
        {
          "name": "Payroll Period End Date",
          "value": "{{dateFormat 'yyyyMMdd' [Payroll End Date]}}"
        },
        {
          "name": "Paycheck Date",
          "value": "{{dateFormat 'yyyyMMdd' [Pay Date]}}"
        },
        {
          "name": "Department",
          "value": ""
        }
      ],
      "children": []
    }
  ]
